# Paymob (Dashboard > Settings > Account Info, and Developers > Payment Integrations)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated integration (payment method) IDs, e.g. your card integration
PAYMOB_INTEGRATION_IDS=
# Supabase service role key (server only, never expose)
SUPABASE_SERVICE_ROLE_KEY=
# Public base URL used for Paymob callbacks/redirects (defaults to request origin)
NEXT_PUBLIC_SITE_URL=
